<script>
    let items: Array<Object> = [];
    let kind: String = "";

    function toggle(): Void {
        toggle_label();
    }
</script>

<use>
    import Badge from "./badge.brul";
</use>

<markup>
    window Picker (title: "picker", width: 800) {
        Column (root, on drag: dragWindow) {
            Text (heading) { "picker" }
            Row (bar) {
                View (class: kind) { }
                @if (kind != "") {
                    Text (hint) { "on" }
                } @else {
                    Text (hint) { "off" }
                }
            }
            @each (items as item, idx (item.id)) {
                Text (row) { item.label }
            }
            Badge (label: "badge", active: kind != "", on clicked: toggle) {
                @slot(extra) {
                    Text (badge-extra) { kind }
                }
            }
        }
    }
</markup>

<style>
    theme dark {
        accent: #6c8cff;
        surface: #111111;
    }
    theme light {
        accent: #112233;
        surface: #eeeeee;
    }
    .root {
        width: 100%;
        padding: 8px;
        background: theme.surface;
    }
    .bar { gap: 4px; align-items: center; }
    .bar:hover { background: theme.accent; }
    .hint {
        font-size: 12px;
        color: theme.accent;
        vertical-align: center;
    }
    .row { padding-top: 2px; }
    .badge-extra { font-size: 10px; }
</style>
