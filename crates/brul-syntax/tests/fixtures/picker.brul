<use>
    import BrowserItem from "./browser_item";
    import Footer from "./footer";
</use>

<markup>
component CheckRow {
    prop label: String = "";
    prop checked: Bool = false;
    event toggled();

    Container (check-row) {
        Container (checkbox, checked: checked, on click: toggle) { }
        Text (text-muted) { label }
    }
}

component BrowserItem {
    prop index: Number = 0;
    prop icon: Image = empty;
    prop emoji: String = "";
    prop name: String = "";
    prop isDefault: Bool = false;
    prop selected: Bool = false;
    event clicked(i: Number);

    Container (browser-item) {
        Container (item-panel, selected: selected, on click: itemClicked) {
            Container (item-icon) {
                if (emoji == "") {
                    Image (item-image) { icon }
                }
            }

            Container (item-body) {
                Container (item-title) {
                    Text (text-main) { name }
                    if (isDefault) {
                        Container (default-badge) {
                            Text (badge-text) { "По умолчанию" }
                        }
                    }
                }
            }
        }
    }
}

window Picker (title: "picker", width: 488, height: 800,
               frameless: true, transparent: true, on key: handleKey) {
    Container (root) {
        each item, i in browsers {
            BrowserItem (index: i, name: item.name, icon: item.icon,
                         emoji: item.emoji, isDefault: item.isDefault,
                         selected: i == selectedIndex,
                         on clicked: launch) { }
        }
    }
}
</markup>

<style>
theme dark {
    accent: #6c8cff;
    border-main: #2a2d34;
}

.checkbox {
    width: 20px;
    border-radius: 6px;
    background: transparent;
    border: 2px theme.border-main;
}
.checkbox:checked {
    background: theme.accent;
    border-color: theme.accent;
}
</style>

<script>
let selectedIndex = 0;

function toggle(): Void {
  checked = !checked;
  toggled();
}

function itemClicked(): Void {
  clicked(index);
}

function handleKey(ev: Object): Void {
  if (ev.code == "Escape") {
    exit();
  }
}
</script>
