<script>
    function changeDraft(value, caret) {
        draft = value;
    }

    function showNote() {
        status = submit(draft);
    }

    function clearNote() {
        draft = "";
        status = clear();
    }

    function applyPreset(i) {
        draft = presets[i];
        status = submit(draft);
    }

    function handleKey(ev) {
        if (ev.ctrl) {
            if (ev.code == "Enter") {
                showNote();
            }
        }
    }
</script>

<use>
    import PresetButton from "./preset_button.brul";
</use>

<markup>
    window Note (
        title: "nobs",
        width: 520,
        height: 480,
        centered: true,
        on key: handleKey
    ) {
        Column (root) {
            Row (header, on drag: dragWindow) {
                Text (title) { "nobs" }
                Text (status) { status }
            }
            TextInput (editor, multiline: true, on input: changeDraft) { draft }
            if (len(presets) > 0) {
                Row (presets) {
                    Column (preset-column) {
                        each (presets as preset, index) {
                            if (index % 2 == 0) {
                                PresetButton (index: index, label: preset, on chosen: applyPreset) { }
                            }
                        }
                    }
                    Column (preset-column) {
                        each (presets as preset, index) {
                            if (index % 2 == 1) {
                                PresetButton (index: index, label: preset, on chosen: applyPreset) { }
                            }
                        }
                    }
                }
            }
            Row (actions) {
                View (primary, on click: showNote) {
                    Text (primary-label) { "Show in OBS" }
                }
                View (secondary, on click: clearNote) {
                    Text (secondary-label) { "Clear" }
                }
            }
            Text (hint) { hint }
        }
    }
</markup>

<style>
    theme dark {
        background: #12141c;
        surface: #1c2028;
        border: #334155;
        text: #ffffff;
        muted: #8c94a8;
        accent: #4c8dff;
    }
    theme light {
        background: #f4f6f9;
        surface: #ffffff;
        border: #e2e8f0;
        text: #0f172a;
        muted: #64748b;
        accent: #2563eb;
    }
    .root {
        width: 100%;
        height: 100%;
        padding: 20px;
        spacing: 14px;
        background: theme.background;
    }
    .header {
        width: 100%;
        height: 32px;
        spacing: 12px;
        align-items: center;
        justify-content: space-between;
    }
    .title { color: theme.text; font-size: 20px; }
    .status { color: theme.muted; font-size: 14px; }
    .editor {
        width: 100%;
        height: 240px;
        padding: 12px;
        background: theme.surface;
        border: 1px theme.border;
        radius: 12px;
        color: theme.text;
        font-size: 15px;
    }
    .actions {
        width: 100%;
        spacing: 10px;
        align-items: center;
    }
    .presets {
        width: 100%;
        spacing: 10px;
    }
    .preset-column {
        width: 50%;
        spacing: 8px;
    }
    .primary {
        height: 34px;
        padding-left: 18px;
        padding-right: 18px;
        align-items: center;
        justify-content: center;
        background: theme.accent;
        radius: 10px;
    }
    .primary-label { color: #ffffff; font-size: 14px; }
    .secondary {
        height: 34px;
        padding-left: 14px;
        padding-right: 14px;
        align-items: center;
        justify-content: center;
        background: theme.surface;
        border: 1px theme.border;
        radius: 10px;
    }
    .secondary-label { color: theme.text; font-size: 14px; }
    .hint { color: theme.muted; font-size: 12px; }
</style>
