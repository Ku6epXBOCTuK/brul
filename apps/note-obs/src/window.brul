<script>
    function changeDraft(ev) {
        draft = ev.value;
    }

    function showNote() {
        status = submit(draft);
        setAlwaysOnTop(draft != "");
    }

    function clearNote() {
        draft = "";
        status = clear();
        setAlwaysOnTop(false);
    }

    function hideNote() {
        hideWindow();
    }

    function applyPreset(i) {
        draft = presets[i];
        status = submit(draft);
        setAlwaysOnTop(true);
    }

    function toggleAfk() {
        afkEnabled = !afkEnabled;
        status = setAfk(afkEnabled);
    }

    function changeAfk(ev) {
        afkText = ev.value;
        setAfkText(afkText);
    }

    function tick() {
        afkNote = afkStatus();
    }

    function afkAway() {
        showWindow();
        focusWindow();
        setAlwaysOnTop(true);
    }

    function afkBack() {
        setAlwaysOnTop(draft != "");
    }

    every(1000, tick);

    function trayShow() {
        showWindow();
    }

    function trayClear() {
        clearNote();
    }

    function trayQuit() {
        exit();
    }

    function handleKey(ev) {
        if (ev.code == "Escape") {
            hideNote();
        } else if (ev.ctrl) {
            if (ev.code == "Enter") {
                showNote();
            } else if (ev.code == "q" || ev.code == "Q") {
                exit();
            }
        }
    }
</script>

<use>
    import PresetButton from "./preset_button.brul";
</use>

<markup>
    window Note (
        title: "nobs",
        width: 520,
        height: 480,
        centered: true,
        on key: handleKey,
        on close: hideNote
    ) {
        Column (root, class: live ? "live" : "") {
            Row (header, on drag: dragWindow) {
                Text (title) { "nobs" }
                Text (status) { status }
            }
            TextInput (editor, multiline: true, on input: changeDraft) { draft }
            if (len(presets) > 0) {
                Row (presets) {
                    Column (preset-column) {
                        each (presets as preset, index) {
                            if (index % 2 == 0) {
                                PresetButton (index: index, label: preset, on chosen: applyPreset) { }
                            }
                        }
                    }
                    Column (preset-column) {
                        each (presets as preset, index) {
                            if (index % 2 == 1) {
                                PresetButton (index: index, label: preset, on chosen: applyPreset) { }
                            }
                        }
                    }
                }
            }
            Row (actions) {
                View (primary, on click: showNote) {
                    Text (primary-label) { "Show in OBS" }
                }
                View (secondary, on click: clearNote) {
                    Text (secondary-label) { "Clear" }
                }
            }
            Row (afk-row) {
                Row (afk-toggle, on click: toggleAfk) {
                    View (afk-box, checked: afkEnabled) {
                        if (afkEnabled) {
                            Text (afk-mark) { "✓" }
                        }
                    }
                    Text (afk-label) { "Отслеживать простой" }
                }
                TextInput (afk-input, on input: changeAfk) { afkText }
            }
            Text (afk-note) { afkNote }
            Text (hint) { hint }
        }
    }
</markup>

<style>
    theme dark {
        background: #12141c;
        surface: #1c2028;
        border: #334155;
        text: #ffffff;
        muted: #8c94a8;
        accent: #4c8dff;
    }
    theme light {
        background: #f4f6f9;
        surface: #ffffff;
        border: #e2e8f0;
        text: #0f172a;
        muted: #64748b;
        accent: #2563eb;
    }
    .root {
        width: 100%;
        height: 100%;
        padding: 18px;
        spacing: 14px;
        background: theme.background;
        border: 2px theme.background;
    }
    .live { border-color: #e24e4e; }
    .header {
        width: 100%;
        height: 32px;
        spacing: 12px;
        align-items: center;
        justify-content: space-between;
    }
    .title { color: theme.text; font-size: 20px; }
    .status { color: theme.muted; font-size: 14px; }
    .editor {
        width: 100%;
        height: 120px;
        stretch: 1;
        padding: 12px;
        background: theme.surface;
        border: 1px theme.border;
        radius: 12px;
        color: theme.text;
        font-size: 15px;
    }
    .actions {
        width: 100%;
        spacing: 10px;
        align-items: center;
    }
    .presets {
        width: 100%;
        spacing: 10px;
    }
    .preset-column {
        width: 50%;
        spacing: 8px;
    }
    .primary {
        height: 34px;
        padding-left: 18px;
        padding-right: 18px;
        align-items: center;
        justify-content: center;
        background: theme.accent;
        radius: 10px;
    }
    .primary-label { color: #ffffff; font-size: 14px; }
    .secondary {
        height: 34px;
        padding-left: 14px;
        padding-right: 14px;
        align-items: center;
        justify-content: center;
        background: theme.surface;
        border: 1px theme.border;
        radius: 10px;
    }
    .secondary-label { color: theme.text; font-size: 14px; }
    .hint { color: theme.muted; font-size: 12px; }
    .afk-row {
        width: 100%;
        spacing: 12px;
        align-items: center;
    }
    .afk-toggle {
        height: 28px;
        spacing: 10px;
        align-items: center;
    }
    .afk-box {
        width: 20px;
        height: 20px;
        background: transparent;
        border: 2px theme.border;
        radius: 6px;
        align-items: center;
        justify-content: center;
    }
    .afk-box:checked {
        background: theme.accent;
        border-color: theme.accent;
    }
    .afk-mark { color: #ffffff; font-size: 12px; }
    .afk-label { color: theme.muted; font-size: 13px; }
    .afk-note { color: theme.muted; font-size: 12px; }
    .afk-input {
        stretch: 1;
        height: 30px;
        padding-left: 10px;
        padding-right: 10px;
        background: theme.surface;
        border: 1px theme.border;
        radius: 8px;
        color: theme.text;
        font-size: 13px;
    }
</style>
