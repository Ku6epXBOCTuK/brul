<script>
    function apply(action, name) {
        let result = act(action, name);
        status = result.status;
        if (result.ok) {
            services = result.services;
        }
    }

    function startService(name) {
        apply("start", name);
    }

    function stopService(name) {
        apply("stop", name);
    }

    function restartService(name) {
        apply("restart", name);
    }

    function startManual() {
        let result = startAllManual();
        status = result.status;
        if (result.ok) {
            services = result.services;
        }
    }
</script>

<use>
    import ServiceRow from "./service_row.brul";
</use>

<markup>
    window Services (title: "Services", width: 900, height: 560, centered: true) {
        Column (root) {
            Row (header) {
                Text (title) { "Services" }
                View (action, primary, on click: startManual) {
                    Text (primary-label) { "Start all manual" }
                }
            }
            Text (status) { status }
            Column (list) {
                @each (services as item) {
                    ServiceRow (name: item.name, display: item.display, state: item.state,
                                start: item.start, port: item.port,
                                on startRequested: startService,
                                on stopRequested: stopService,
                                on restartRequested: restartService) { }
                }
            }
        }
    }
</markup>

<style>
    theme dark {
        background: #12141c;
        surface: #1c2028;
        border: #334155;
        text: #ffffff;
        muted: #8c94a8;
        accent: #4c8dff;
    }
    theme light {
        background: #f4f6f9;
        surface: #ffffff;
        border: #e2e8f0;
        text: #0f172a;
        muted: #64748b;
        accent: #2563eb;
    }
    .root {
        width: 100%;
        height: 100%;
        padding: 18px;
        gap: 12px;
        background: theme.background;
    }
    .header {
        width: 100%;
        height: 40px;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
    }
    .title { color: theme.text; font-size: 22px; }
    .status { color: theme.muted; font-size: 13px; }
    .list {
        width: 100%;
        gap: 8px;
    }
    .action {
        height: 32px;
        padding-left: 14px;
        padding-right: 14px;
        align-items: center;
        justify-content: center;
        background: theme.surface;
        border: 1px theme.border;
        border-radius: 8px;
    }
    .action:hover { background: theme.border; }
    .primary { background: theme.accent; border-color: theme.accent; }
    .primary-label { color: #ffffff; font-size: 13px; }
</style>
