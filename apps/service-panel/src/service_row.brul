<script>
    function startService() {
        startRequested(name);
    }

    function stopService() {
        stopRequested(name);
    }

    function restartService() {
        restartRequested(name);
    }
</script>

<markup>
    component ServiceRow {
        prop name: String = "";
        prop display: String = "";
        prop state: String = "";
        prop start: String = "";
        prop port: String = "";
        event startRequested(service: String);
        event stopRequested(service: String);
        event restartRequested(service: String);

        Row (row) {
            Column (row-titles) {
                Text (row-name) { name }
                Text (row-display) { display }
            }
            Column (row-meta) {
                Text (row-state, class: state == "running" ? "running" : "idle") { state }
                Text (row-start) { start }
            }
            Text (row-port) { port }
            View (row-action, on click: startService) {
                Text (row-action-label) { "Start" }
            }
            View (row-action, on click: stopService) {
                Text (row-action-label) { "Stop" }
            }
            View (row-action, on click: restartService) {
                Text (row-action-label) { "Restart" }
            }
        }
    }
</markup>

<style>
    .row {
        width: 100%;
        height: 52px;
        padding-left: 12px;
        padding-right: 12px;
        gap: 12px;
        align-items: center;
        background: theme.surface;
        border: 1px theme.border;
        border-radius: 10px;
    }
    .row-titles {
        flex-grow: 1;
        gap: 2px;
    }
    .row-name { color: theme.text; font-size: 14px; }
    .row-display { color: theme.muted; font-size: 12px; }
    .row-meta {
        width: 150px;
        gap: 2px;
    }
    .row-state { font-size: 13px; }
    .running { color: #4ade80; }
    .idle { color: theme.muted; }
    .row-start { color: theme.muted; font-size: 12px; }
    .row-port { width: 60px; color: theme.muted; font-size: 13px; }
    .row-action {
        height: 28px;
        padding-left: 10px;
        padding-right: 10px;
        align-items: center;
        justify-content: center;
        background: theme.background;
        border: 1px theme.border;
        border-radius: 7px;
    }
    .row-action:hover { background: theme.border; }
    .row-action-label { color: theme.text; font-size: 12px; }
</style>
