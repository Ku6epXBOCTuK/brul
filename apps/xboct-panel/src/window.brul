<script>
    function apply(action, name) {
        let result = act(action, name);
        status = result.status;
        if (result.ok) {
            services = result.services;
        }
    }

    function startService(name) {
        apply("start", name);
    }

    function stopService(name) {
        apply("stop", name);
    }

    function restartService(name) {
        apply("restart", name);
    }

    function startManual() {
        let result = startAllManual();
        status = result.status;
        if (result.ok) {
            services = result.services;
        }
    }

    function poll() {
        let result = refresh(selected);
        if (result.ok) {
            services = result.services;
        }
        log = result.log;
    }

    function selectService(name) {
        selected = name;
        poll();
    }

    function showConsole(name) {
        let result = toggleConsole(name);
        status = result.status;
    }

    function openNew() {
        let result = entryDraft("");
        status = result.status;
        if (result.ok) {
            draft = result.draft;
            dialogOpen = true;
        }
    }

    function openEditor(name) {
        let result = entryDraft(name);
        status = result.status;
        if (result.ok) {
            draft = result.draft;
            dialogOpen = true;
        }
    }

    function finishDialog(result) {
        dialogOpen = false;
        if (result) {
            let saved = saveEntry(draft.original, draft.kind, draft.name, draft.command,
                draft.args, draft.workdir, draft.env, draft.port, draft.log,
                draft.restart, draft.start, draft.hidden);
            status = saved.status;
            if (saved.ok) {
                services = saved.services;
            }
        }
    }

    function changeKind(ev) { draft.kind = ev.value; }
    function changeName(ev) { draft.name = ev.value; }
    function changeCommand(ev) { draft.command = ev.value; }
    function changeArgs(ev) { draft.args = ev.value; }
    function changeWorkdir(ev) { draft.workdir = ev.value; }
    function changeEnv(ev) { draft.env = ev.value; }
    function changePort(ev) { draft.port = ev.value; }
    function changeLog(ev) { draft.log = ev.value; }
    function changeRestart(ev) { draft.restart = ev.value; }
    function changeStart(ev) { draft.start = ev.value; }

    function toggleHidden() { draft.hidden = !draft.hidden; }

    function startHidden() {
        hideWindow();
    }

    function hideToTray() {
        hideWindow();
    }

    function trayShow() {
        showWindow();
    }

    function trayQuit() {
        exit();
    }

    every(2000, poll);
</script>

<use>
    import Checkbox from "brul:checkbox";
    import Dialog from "brul:dialog";
    import ServiceRow from "./service_row.brul";
</use>

<markup>
    window Services (title: "xboct-panel", width: 900, height: 560, centered: true, on close: hideToTray) {
        Column (root) {
            Row (header) {
                Text (title) { "xboct-panel" }
                View (action, on click: openNew) {
                    Text (action-label) { "Add entry" }
                }
                View (action, primary, on click: startManual) {
                    Text (primary-label) { "Start all manual" }
                }
            }
            Text (status) { status }
            Column (list) {
                @if (len(services) == 0) {
                    Text (empty) { "No entries in xboct-panel.toml" }
                }
                @each (services as item) {
                    ServiceRow (name: item.name, display: item.display, state: item.state,
                                start: item.start, port: item.port,
                                selected: item.name == selected,
                                console: item.start == "console",
                                on selectRequested: selectService,
                                on startRequested: startService,
                                on stopRequested: stopService,
                                on restartRequested: restartService,
                                on consoleRequested: showConsole,
                                on editRequested: openEditor) { }
                }
            }
            Column (log-box) {
                Text (log-title) { "Log" }
                Column (log-body) {
                    Text (log-text) { log }
                }
            }
            Dialog (open: dialogOpen, title: "Entry", confirm: "Save", cancel: "Cancel", on closed: finishDialog) {
                Column (fields) {
                    Row (field-row) {
                        Column (field) {
                            Text (field-label) { "Kind (service, program, console)" }
                            TextInput (field-input, on input: changeKind) { draft.kind }
                        }
                        Column (field) {
                            Text (field-label) { "Name" }
                            TextInput (field-input, on input: changeName) { draft.name }
                        }
                    }
                    Column (field) {
                        Text (field-label) { "Command" }
                        TextInput (field-input, on input: changeCommand) { draft.command }
                    }
                    Column (field) {
                        Text (field-label) { "Arguments, one per line" }
                        TextInput (field-input, on input: changeArgs) { draft.args }
                    }
                    Row (field-row) {
                        Column (field) {
                            Text (field-label) { "Working folder" }
                            TextInput (field-input, on input: changeWorkdir) { draft.workdir }
                        }
                        Column (field) {
                            Text (field-label) { "Port" }
                            TextInput (field-input, on input: changePort) { draft.port }
                        }
                    }
                    Column (field) {
                        Text (field-label) { "Environment, KEY=VALUE per line" }
                        TextInput (field-input, on input: changeEnv) { draft.env }
                    }
                    Row (field-row) {
                        Column (field) {
                            Text (field-label) { "Log file" }
                            TextInput (field-input, on input: changeLog) { draft.log }
                        }
                        Column (field) {
                            Text (field-label) { "Restart (never, on-crash)" }
                            TextInput (field-input, on input: changeRestart) { draft.restart }
                        }
                    }
                    Row (field-row) {
                        Column (field) {
                            Text (field-label) { "Start (auto, manual)" }
                            TextInput (field-input, on input: changeStart) { draft.start }
                        }
                        Checkbox (label: "Hidden", checked: draft.hidden, on toggled: toggleHidden) { }
                    }
                }
            }
        }
    }
</markup>

<style>
    theme dark {
        background: #12141c;
        surface: #1c2028;
        surface-hover: #262b36;
        border: #334155;
        text: #ffffff;
        muted: #8c94a8;
        accent: #4c8dff;
        accent-hover: #3b7ef5;
    }
    theme light {
        background: #f4f6f9;
        surface: #ffffff;
        surface-hover: #f1f5f9;
        border: #e2e8f0;
        text: #0f172a;
        muted: #64748b;
        accent: #2563eb;
        accent-hover: #1d4ed8;
    }
    .root {
        width: 100%;
        height: 100%;
        padding: 18px;
        gap: 12px;
        background: theme.background;
    }
    .header {
        width: 100%;
        height: 40px;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
    }
    .title { color: theme.text; font-size: 22px; }
    .status { color: theme.muted; font-size: 13px; }
    .list {
        width: 100%;
        flex-grow: 1;
        gap: 8px;
        scroll: true;
    }
    .empty { color: theme.muted; font-size: 13px; }
    .log-box {
        width: 100%;
        height: 170px;
        padding: 10px;
        gap: 6px;
        background: theme.surface;
        border: 1px theme.border;
        border-radius: 10px;
    }
    .log-title { color: theme.muted; font-size: 12px; }
    .log-body {
        width: 100%;
        flex-grow: 1;
        clip: true;
        justify-content: end;
    }
    .log-text { color: theme.text; font-size: 12px; }
    .action {
        height: 32px;
        padding-left: 14px;
        padding-right: 14px;
        align-items: center;
        justify-content: center;
        background: theme.surface;
        border: 1px theme.border;
        border-radius: 8px;
    }
    .action:hover { background: theme.border; }
    .action-label { color: theme.text; font-size: 13px; }
    .primary { background: theme.accent; border-color: theme.accent; }
    .primary-label { color: #ffffff; font-size: 13px; }
    .fields {
        width: 100%;
        gap: 10px;
    }
    .field-row {
        width: 100%;
        gap: 10px;
    }
    .field {
        flex-grow: 1;
        gap: 4px;
    }
    .field-label { color: theme.muted; font-size: 11px; }
    .field-input {
        width: 100%;
        height: 30px;
        padding-left: 8px;
        padding-right: 8px;
        background: theme.background;
        border: 1px theme.border;
        border-radius: 6px;
        color: theme.text;
        font-size: 13px;
    }
</style>
