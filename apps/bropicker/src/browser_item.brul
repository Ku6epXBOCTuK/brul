<script>
    function choose() {
        clicked(index);
    }
</script>

<use>
    resource check from "../assets/icons/check.png";
</use>

<markup>
    component BrowserItem {
        prop index: Number = 0;
        prop icon: Image = null;
        prop emoji: String = "";
        prop masked: Bool = false;
        prop name: String = "";
        prop isDefault: Bool = false;
        prop selected: Bool = false;
        event clicked(i: Number);

        View (item) {
            View (panel, on click: choose, selected: selected) {
                Row (body) {
                    View (plate) {
                        if (index % 4 == 0) {
                            View (plate-tint, tone-first, x: 0, y: 0) { }
                        }
                        if (index % 4 == 1) {
                            View (plate-tint, tone-second, x: 0, y: 0) { }
                        }
                        if (index % 4 == 2) {
                            View (plate-tint, tone-third, x: 0, y: 0) { }
                        }
                        if (index % 4 == 3) {
                            View (plate-tint, tone-fourth, x: 0, y: 0) { }
                        }
                        Row (plate-body) {
                            if (emoji != "") {
                                Text (plate-emoji) { emoji }
                            }
                            if (emoji == "" && masked) {
                                Image (plate-icon, plate-icon-masked) { icon }
                            }
                            if (emoji == "" && !masked) {
                                Image (plate-icon) { icon }
                            }
                        }
                    }
                    Row (details) {
                        Text (item-name) { name }
                        if (isDefault) {
                            View (default-badge) {
                                Text (badge-text) { "По умолчанию" }
                            }
                        }
                    }
                    if (selected) {
                        View (tail, tail-selected) {
                            Row (tail-row) {
                                Image (tail-check) { check }
                            }
                        }
                    }
                    if (!selected) {
                        View (tail) {
                            Row (tail-row) {
                                Text (tail-chevron) { "›" }
                            }
                        }
                    }
                }
            }
        }
    }
</markup>

<style>
    theme dark {
        surface-item: #1e293b4d;
        surface-hover: #1e293b;
        surface-elevated: #1e293b80;
        accent: #3b82f6;
        accent-ring: #3b82f680;
        accent-soft: #3b82f620;
        icon-backplate: #334155;
        text: #ffffff;
        muted: #94a3b8;
        badge-text: #60a5fa;
    }
    theme light {
        surface-item: #f8fafc;
        surface-hover: #ffffff;
        surface-elevated: #f8fafc;
        accent: #3b82f6;
        accent-ring: #3b82f680;
        accent-soft: #3b82f620;
        icon-backplate: #e2e8f0;
        text: #0f172a;
        muted: #64748b;
        badge-text: #60a5fa;
    }
    .item {
        width: 100%;
        height: 84px;
        padding-top: 4px;
        padding-bottom: 4px;
        background: transparent;
    }
    .panel {
        width: 100%;
        height: 100%;
        background: theme.surface-item;
        border: 2px transparent;
        radius: 12px;
        animate background: 300ms;
        animate border-color: 300ms;
    }
    .panel:hover { background: theme.surface-hover; }
    .panel:selected {
        background: theme.surface-elevated;
        border-color: theme.accent-ring;
    }
    .body {
        width: 100%;
        height: 100%;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 16px;
        align-items: center;
    }
    .plate {
        width: 48px;
        height: 48px;
        radius: 12px;
    }
    .plate-tint {
        width: 100%;
        height: 100%;
        radius: 12px;
    }
    .tone-first { background: linear-gradient(135deg, #fb923c, #ef4444); }
    .tone-second { background: linear-gradient(135deg, #f472b6, #e11d48); }
    .tone-third { background: linear-gradient(135deg, #22d3ee, #10b981); }
    .tone-fourth { background: linear-gradient(135deg, #a78bfa, #7c3aed); }
    .plate-body {
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
    }
    .plate-emoji {
        font-size: 26px;
        text-align: center;
        vertical-align: center;
    }
    .plate-icon {
        width: 30px;
        height: 30px;
    }
    .plate-icon-masked { tint: #ffffff; }
    .details { stretch: 1; spacing: 8px; align-items: center; }
    .item-name {
        color: theme.text;
        font-size: 16px;
        font-weight: 500;
        vertical-align: center;
    }
    .default-badge {
        height: 22px;
        padding-left: 10px;
        padding-right: 10px;
        align-items: center;
        justify-content: center;
        background: theme.accent-soft;
        radius: 11px;
    }
    .badge-text {
        color: theme.badge-text;
        font-size: 12px;
        vertical-align: center;
    }
    .tail {
        width: 32px;
        height: 32px;
        background: theme.icon-backplate;
        radius: 16px;
    }
    .tail-selected { background: theme.accent; }
    .tail-row {
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
    }
    .tail-check {
        width: 16px;
        height: 16px;
        tint: #ffffff;
    }
    .tail-chevron {
        color: theme.muted;
        font-size: 18px;
        text-align: center;
        vertical-align: center;
    }
</style>
