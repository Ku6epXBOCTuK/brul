<script>
    function toggle() {
        checked = !checked;
        toggled();
    }
</script>

<use>
    resource check from "../assets/icons/check.png";
</use>

<markup>
    component CheckRow {
        prop label: String = "";
        prop checked: Bool = false;
        event toggled();

        Row (check-row, on click: toggle) {
            View (checkbox, checked: checked) {
                Image (check-mark, visible: checked) { check }
            }
            Text (label) { label }
        }
    }
</markup>

<style>
    theme dark {
        accent: #60a5fa;
        border: #333a46;
        muted: #98a2b3;
    }
    theme light {
        accent: #2563eb;
        border: #d6dce5;
        muted: #647080;
    }
    .check-row {
        width: 100%;
        height: 28px;
        spacing: 12px;
        padding-left: 12px;
        align-items: center;
    }
    .checkbox {
        width: 20px;
        height: 20px;
        background: transparent;
        border: 2px theme.border;
        radius: 6px;
        align-items: center;
        justify-content: center;
    }
    .checkbox:checked {
        background: theme.accent;
        border-color: theme.accent;
    }
    .check-mark {
        width: 12px;
        height: 12px;
        tint: #ffffff;
    }
    .label {
        color: theme.muted;
        font-size: 16px;
    }
</style>
