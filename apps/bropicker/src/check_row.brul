<script>
    function toggle() {
        checked = !checked;
        toggled();
    }
</script>

<markup>
    component CheckRow {
        prop label: String = ""
        prop checked: Bool = false
        event toggled()

        Row (check-row, on click: toggle) {
            View (checkbox, checked: checked) { }
            Text (label) { label }
        }
    }
</markup>

<style>
    .check-row {
        spacing: 8px;
        padding: 4px;
        align-items: center;
    }
    .checkbox {
        width: 16px;
        height: 16px;
        background: #232831;
        border: 1px #333a46;
        radius: 4px;
    }
    .checkbox:checked {
        background: #60a5fa;
        border-color: #60a5fa;
    }
    .label {
        color: #98a2b3;
        font-size: 12px;
        font-weight: 500;
    }
</style>
