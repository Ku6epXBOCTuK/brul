<script>
    function toggle() {
        checked = !checked;
        toggled();
    }
</script>

<markup>
    component CheckRow {
        prop label: String = ""
        prop checked: Bool = false
        event toggled()

        Row (check-row, on click: toggle) {
            View (checkbox, checked: checked) { }
            Text (label) { label }
        }
    }
</markup>

<style>
    theme dark {
        accent: #60a5fa;
        item: #232831;
        border: #333a46;
        muted: #98a2b3;
    }
    theme light {
        accent: #2563eb;
        item: #eef1f6;
        border: #d6dce5;
        muted: #647080;
    }
    .check-row { spacing: 8px; align-items: center; }
    .checkbox {
        width: 16px;
        height: 16px;
        background: theme.item;
        border: 1px theme.border;
        radius: 4px;
    }
    .checkbox:checked {
        background: theme.accent;
        border-color: theme.accent;
    }
    .label {
        color: theme.muted;
        font-size: 12px;
        font-weight: 500;
    }
</style>
