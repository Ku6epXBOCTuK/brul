<use>
    import Badge from "./badge.brul";
</use>

<script>
    function handleBump() {
    }
</script>

<markup>
    window Bropicker (
        title: "bropicker",
        width: 488,
        height: 800,
        frameless: true,
        transparent: true
    ) {
        Column {
            if (url != "") {
                Text { url }
            } else {
                Text { "bropicker" }
            }
            each (browsers as browser) {
                Text { browser }
            }
            Badge (label: "badge", on bumped: handleBump) { }
        }
    }
</markup>
