<script>
    let selectedIndex = selected;
    let rememberChoice = remember;
    let alwaysAskChoice = alwaysAsk;

    function launch(i) {
        selectedIndex = i;
        launchBrowser(i);
    }

    function toggleRemember() {
        rememberChoice = !rememberChoice;
    }

    function toggleAlwaysAsk() {
        alwaysAskChoice = !alwaysAskChoice;
    }

    function handleKey(ev) {
        if (ev.code == "Escape") {
            exit();
        }
    }

    function handleSettingsKey(ev) {
        if (ev.code == "Escape") {
            exit();
        }
    }

    function openSettings() {
        openWindow("Settings");
    }

    function removeBrowserRow(name) {
        browsers = removeBrowser(name);
    }

    function removeRememberedRow(domain) {
        remembered = removeRemembered(domain);
    }

    function redetect() {
        browsers = detectBrowsers();
    }
</script>

<use>
    import BrowserItem from "./browser_item.brul";
    import CheckRow from "./check_row.brul";
    import SettingsRow from "./settings_row.brul";
</use>

<markup>
    window Picker (
        title: "bropicker",
        width: 488,
        height: 800,
        frameless: true,
        transparent: true,
        on key: handleKey
    ) {
        Column (root) {
            Column (header, on drag: dragWindow) {
                Text (muted) { "bropicker" }
                Text (text) { url }
            }
            Column (list) {
                each (browsers as browser, index (browser.name)) {
                    BrowserItem (index: index, icon: browser.icon, name: browser.name,
                                path: browser.path, isDefault: browser.isDefault,
                                selected: index == selectedIndex,
                                on clicked: launch) { }
                }
            }
            Row (footer) {
                CheckRow (label: "Remember choice", checked: rememberChoice,
                        on toggled: toggleRemember) { }
                CheckRow (label: "Always ask", checked: alwaysAskChoice,
                        on toggled: toggleAlwaysAsk) { }
                Text (settings-button, on click: openSettings) { "Settings" }
            }
        }
    }

    window Settings (
        title: "bropicker - settings",
        width: 760,
        height: 560,
        on key: handleSettingsKey
    ) {
        Column (settings-root) {
            Text (settings-title) { "Settings" }
            Row (settings-columns) {
                Column (settings-panel) {
                    Row (settings-head) {
                        Text (muted) { "Browsers" }
                        Text (settings-action, on click: redetect) { "Autodetect" }
                    }
                    Column (settings-list) {
                        each (browsers as browser, index (browser.name)) {
                            SettingsRow (name: browser.name, detail: browser.path,
                                        on removed: removeBrowserRow) { }
                        }
                    }
                }
                Column (settings-panel) {
                    Row (settings-head) {
                        Text (muted) { "Saved domains" }
                    }
                    Column (settings-list) {
                        each (remembered as record, index (record.domain)) {
                            SettingsRow (name: record.domain, detail: record.browser,
                                        on removed: removeRememberedRow) { }
                        }
                    }
                }
            }
        }
    }
</markup>

<style>
    theme dark {
        background: #14171d;
        surface: #1c2028;
        text: #f0f3f8;
        muted: #98a2b3;
    }
    theme light {
        background: #f4f6f9;
        surface: #ffffff;
        text: #171c24;
        muted: #647080;
    }
    .root {
        width: 100%;
        height: 100%;
        padding: 16px;
        spacing: 12px;
        background: theme.background;
        radius: 22px;
    }
    .header {
        width: 100%;
        height: 56px;
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 2px;
        background: theme.surface;
        radius: 14px;
    }
    .text { color: theme.text; font-size: 16px; font-weight: 600; }
    .muted { color: theme.muted; font-size: 12px; }
    .list { width: 100%; stretch: 1; spacing: 8px; }
    .footer {
        width: 100%;
        height: 44px;
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 24px;
        align-items: center;
        background: theme.surface;
        radius: 12px;
    }
    .settings-button {
        color: theme.muted;
        font-size: 12px;
        padding: 6px;
        radius: 8px;
    }
    .settings-button:hover { color: theme.text; }
    .settings-root {
        width: 100%;
        height: 100%;
        padding: 20px;
        spacing: 14px;
        background: theme.background;
    }
    .settings-title { color: theme.text; font-size: 20px; font-weight: 600; }
    .settings-columns { width: 100%; stretch: 1; spacing: 14px; }
    .settings-panel { stretch: 1; spacing: 8px; }
    .settings-head {
        width: 100%;
        height: 26px;
        spacing: 8px;
        align-items: center;
        justify-content: space-between;
    }
    .settings-action {
        color: theme.muted;
        font-size: 12px;
        padding: 4px 10px;
        background: theme.surface;
        radius: 8px;
    }
    .settings-action:hover { color: theme.text; }
    .settings-list {
        width: 100%;
        stretch: 1;
        spacing: 6px;
        clip: true;
        scroll: true;
    }
</style>
