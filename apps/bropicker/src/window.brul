<script>
    let selectedIndex = selected;
    let rememberChoice = remember;
    let alwaysAskChoice = alwaysAsk;
    let rememberLabel = `Запомнить выбор для ${domain}`;
    let darkTheme = dark;

    function launch(i) {
        selectedIndex = i;
        if (launchBrowser(i)) {
            exit();
        }
    }

    function openSelected() {
        launch(selectedIndex);
    }

    function toggleTheme() {
        darkTheme = !darkTheme;
        set_theme(darkTheme ? "dark" : "light");
    }

    function toggleRemember() {
        rememberChoice = !rememberChoice;
    }

    function toggleAlwaysAsk() {
        alwaysAskChoice = !alwaysAskChoice;
    }

    function handleKey(ev) {
        if (ev.code == "Escape") {
            exit();
        }
    }

    function handleSettingsKey(ev) {
        if (ev.code == "Escape") {
            exit();
        }
    }

    function openSettings() {
        openWindow("Settings");
    }

    function removeBrowserRow(name) {
        browsers = removeBrowser(name);
    }

    function removeRememberedRow(domain) {
        remembered = removeRemembered(domain);
    }

    function redetect() {
        browsers = detectBrowsers();
    }
</script>

<use>
    import BrowserItem from "./browser_item.brul";
    import CheckRow from "./check_row.brul";
    import SettingsRow from "./settings_row.brul";
    resource globe from "../assets/icons/globe.png";
    resource external_link from "../assets/icons/external_link.png";
    resource sun from "../assets/icons/sun.png";
    resource cog from "../assets/icons/cog.png";
</use>

<markup>
    window Picker (
        title: "bropicker",
        width: 488,
        height: 800,
        frameless: true,
        transparent: true,
        on key: handleKey
    ) {
        Column (root) {
            Column (card) {
                Column (header, on drag: dragWindow) {
                    Row (header-top) {
                        View (app-icon) {
                            Row (app-icon-row) {
                                Image (app-icon-image) { globe }
                            }
                        }
                        Column (header-titles) {
                            Text (title) { "Выбрать браузер" }
                            Text (subtitle) { "Для открытия ссылки" }
                        }
                    }
                    View (url-field) {
                        Row (url-row) {
                            Image (url-icon) { external_link }
                            Text (url-text) { url }
                        }
                    }
                }
                View (header-rule) { }
                Column (list) {
                    each (browsers as browser, index (browser.name)) {
                        BrowserItem (index: index, icon: browser.icon, emoji: browser.emoji,
                                    masked: browser.masked, name: browser.name,
                                    isDefault: browser.isDefault,
                                    selected: index == selectedIndex,
                                    on clicked: launch) { }
                    }
                }
                Column (choices) {
                    CheckRow (label: rememberLabel, checked: rememberChoice,
                            on toggled: toggleRemember) { }
                    CheckRow (label: "Всегда спрашивать", checked: alwaysAskChoice,
                            on toggled: toggleAlwaysAsk) { }
                }
                Column (footer) {
                    View (footer-rule) { }
                    Row (footer-content) {
                        Row (footer-actions) {
                            View (theme-button, on click: toggleTheme) {
                                Image (footer-icon) { sun }
                            }
                            View (settings-button, on click: openSettings) {
                                Image (footer-icon) { cog }
                            }
                        }
                        Text (footer-hint) { "Escape - закрыть" }
                        View (open-button, on click: openSelected) {
                            Text (open-label) { "Открыть" }
                        }
                    }
                }
            }
        }
    }

    window Settings (
        title: "bropicker - settings",
        width: 760,
        height: 560,
        on key: handleSettingsKey
    ) {
        Column (settings-root) {
            Text (settings-title) { "Settings" }
            Row (settings-columns) {
                Column (settings-panel) {
                    Row (settings-head) {
                        Text (muted) { "Browsers" }
                        Text (settings-action, on click: redetect) { "Autodetect" }
                    }
                    Column (settings-list) {
                        each (browsers as browser, index (browser.name)) {
                            SettingsRow (name: browser.name, detail: browser.path,
                                        on removed: removeBrowserRow) { }
                        }
                    }
                }
                Column (settings-panel) {
                    Row (settings-head) {
                        Text (muted) { "Saved domains" }
                    }
                    Column (settings-list) {
                        each (remembered as record, index (record.domain)) {
                            SettingsRow (name: record.domain, detail: record.browser,
                                        on removed: removeRememberedRow) { }
                        }
                    }
                }
            }
        }
    }
</markup>

<style>
    theme dark {
        background: #14171d;
        surface: #1c2028;
        surface-main: #0f172a;
        surface-elevated: #1e293b80;
        border: #334155;
        text: #ffffff;
        muted: #94a3b8;
        control: #cbd5e1;
        hint: #475569;
    }
    theme light {
        background: #f4f6f9;
        surface: #ffffff;
        surface-main: #ffffff;
        surface-elevated: #f8fafc;
        border: #e2e8f0;
        text: #0f172a;
        muted: #64748b;
        control: #475569;
        hint: #475569;
    }
    .root {
        width: 100%;
        height: 100%;
        padding: 20px;
        background: transparent;
    }
    .card {
        width: 100%;
        height: 100%;
        background: theme.surface-main;
        border: 1px theme.border;
        radius: 16px;
        clip: true;
    }
    .header {
        width: 100%;
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 20px;
        padding-bottom: 12px;
        spacing: 12px;
    }
    .header-top {
        width: 100%;
        spacing: 12px;
        align-items: center;
    }
    .app-icon {
        width: 48px;
        height: 48px;
        radius: 12px;
        background: linear-gradient(135deg, #3b82f6, #06b6d4);
    }
    .app-icon-row {
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
    }
    .app-icon-image {
        width: 24px;
        height: 24px;
        tint: #ffffff;
    }
    .header-titles {
        stretch: 1;
        spacing: 4px;
        justify-content: center;
    }
    .title { color: theme.text; font-size: 18px; font-weight: 600; }
    .subtitle { color: theme.muted; font-size: 14px; }
    .url-field {
        width: 100%;
        height: 44px;
        background: theme.surface-elevated;
        border: 1px theme.border;
        radius: 12px;
    }
    .url-row {
        width: 100%;
        height: 100%;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        align-items: center;
    }
    .url-icon {
        width: 16px;
        height: 16px;
        tint: theme.muted;
    }
    .url-text {
        color: theme.control;
        font-size: 14px;
        font-family: "Consolas";
    }
    .header-rule {
        width: 100%;
        height: 1px;
        background: theme.border;
    }
    .muted { color: theme.muted; font-size: 12px; }
    .list {
        width: 100%;
        stretch: 1;
        spacing: 0px;
        padding-left: 12px;
        padding-right: 12px;
    }
    .choices {
        width: 100%;
        padding: 12px 0px 8px 4px;
        spacing: 8px;
    }
    .footer {
        width: 100%;
        height: 49px;
    }
    .footer-rule {
        width: 100%;
        height: 1px;
        background: theme.border;
    }
    .footer-content {
        width: 100%;
        stretch: 1;
        padding-left: 16px;
        padding-right: 12px;
        spacing: 16px;
        align-items: center;
        justify-content: space-between;
    }
    .footer-actions {
        spacing: 16px;
        align-items: center;
    }
    .theme-button {
        width: 24px;
        height: 24px;
    }
    .settings-button {
        width: 24px;
        height: 24px;
    }
    .footer-icon {
        width: 24px;
        height: 24px;
        tint: theme.muted;
    }
    .footer-icon:hover { tint: theme.text; }
    .footer-hint {
        color: theme.hint;
        font-size: 14px;
    }
    .open-button {
        height: 32px;
        padding-left: 20px;
        padding-right: 20px;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #3b82f6, #06b6d4);
        radius: 12px;
        box-shadow: 0px 10px 15px transparent;
        animate box-shadow-color: 300ms;
    }
    .open-button:hover { box-shadow-color: #3b82f640; }
    .open-label {
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
    }
    .settings-root {
        width: 100%;
        height: 100%;
        padding: 20px;
        spacing: 14px;
        background: theme.background;
    }
    .settings-title { color: theme.text; font-size: 20px; font-weight: 600; }
    .settings-columns { width: 100%; stretch: 1; spacing: 14px; }
    .settings-panel { stretch: 1; spacing: 8px; }
    .settings-head {
        width: 100%;
        height: 26px;
        spacing: 8px;
        align-items: center;
        justify-content: space-between;
    }
    .settings-action {
        color: theme.muted;
        font-size: 12px;
        padding: 4px 10px;
        background: theme.surface;
        radius: 8px;
    }
    .settings-action:hover { color: theme.text; }
    .settings-list {
        width: 100%;
        stretch: 1;
        spacing: 6px;
        clip: true;
        scroll: true;
    }
</style>
