        justify-content: space-between;
    }
    .footer-actions {
        gap: 16px;
        align-items: center;
    }
    .icon-button {
        width: 24px;
        height: 24px;
    }
    .footer-icon {
        width: 24px;
        height: 24px;
        tint: theme.muted;
    }
    .footer-icon:hover { tint: theme.text; }
    .footer-hint {
        color: theme.hint;
        font-size: 14px;
    }
    .open-button {
        height: 32px;
        padding-left: 20px;
        padding-right: 20px;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, theme.accent, theme.accent-to);
        border-radius: 12px;
        box-shadow: 0px 10px 15px transparent;
        animate box-shadow-color: 300ms;
    }
    .open-button:hover { box-shadow-color: alpha(theme.accent, 25%); }
    .open-label {
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
    }
    .settings-root {
        width: 100%;
        height: 100%;
        padding: 20px;
        gap: 14px;
        background: theme.background;
    }
    .settings-title { color: theme.text; font-size: 20px; font-weight: 600; }
    .settings-columns { width: 100%; flex-grow: 1; gap: 14px; }
    .settings-panel { flex-grow: 1; gap: 8px; }
    .settings-head {
        width: 100%;
        height: 26px;
        gap: 8px;
        align-items: center;
        justify-content: space-between;
    }
    .settings-action {
        color: theme.muted;
        font-size: 12px;
        padding: 4px 10px;
        background: theme.surface;
        border-radius: 8px;
    }
    .settings-action:hover { color: theme.text; }
    .settings-list {
        width: 100%;
        flex-grow: 1;
        gap: 6px;
