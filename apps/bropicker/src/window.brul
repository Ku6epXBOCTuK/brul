<script>
    let selectedIndex = selected;
    let rememberChoice = remember;
    let alwaysAskChoice = alwaysAsk;
    let rememberLabel = `Запомнить выбор для ${domain}`;

    function launch(i) {
        selectedIndex = i;
        if (launchBrowser(i)) {
            exit();
        }
    }

    function openSelected() {
        launch(selectedIndex);
    }

    function toggleTheme() {
        set_theme(theme() == "dark" ? "light" : "dark");
    }

    function toggleRemember() {
        rememberChoice = !rememberChoice;
        saveSettings(rememberChoice, alwaysAskChoice);
    }

    function toggleAlwaysAsk() {
        alwaysAskChoice = !alwaysAskChoice;
        saveSettings(rememberChoice, alwaysAskChoice);
    }

    function closeOnEscape(ev) {
        if (ev.code == "Escape") {
            exit();
        }
    }

    function openSettings() {
        openWindow("Settings");
    }

    function removeBrowserRow(name) {
        browsers = removeBrowser(name);
    }

    function removeRememberedRow(domain) {
        remembered = removeRemembered(domain);
    }

    function redetect() {
        browsers = detectBrowsers();
    }
</script>

<use>
    import BrowserItem from "./browser_item.brul";
    import CheckRow from "./check_row.brul";
    import SettingsRow from "./settings_row.brul";
    resource globe from "../assets/icons/globe.svg";
    resource external_link from "../assets/icons/external_link.svg";
    resource sun from "../assets/icons/sun.svg";
    resource cog from "../assets/icons/cog.svg";
</use>

<markup>
    window Picker (
        title: "bropicker",
        width: 488,
        height: 800,
        frameless: true,
        transparent: true,
        on key: closeOnEscape
    ) {
        Column (root) {
            Column (card) {
                Column (header, on drag: dragWindow) {
                    Row (header-top) {
                        View (app-icon) {
                            Image (app-icon-image) { globe }
                        }
                        Column (header-titles) {
                            Text (title) { "Выбрать браузер" }
                            Text (subtitle) { "Для открытия ссылки" }
                        }
                    }
                    Row (url-field) {
                        Image (url-icon) { external_link }
                        Text (url-text) { url }
                    }
                }
                View (rule) { }
                Column (list) {
                    @each (browsers as browser, index (browser.name)) {
                        BrowserItem (index: index, icon: browser.icon, emoji: browser.emoji,
                                    masked: browser.masked, name: browser.name,
                                    isDefault: browser.isDefault,
                                    selected: index == selectedIndex,
                                    on clicked: launch) { }
                    }
                }
                Column (choices) {
                    CheckRow (label: rememberLabel, checked: rememberChoice,
                            on toggled: toggleRemember) { }
                    CheckRow (label: "Всегда спрашивать", checked: alwaysAskChoice,
                            on toggled: toggleAlwaysAsk) { }
                }
                Column (footer) {
                    View (rule) { }
                    Row (footer-content) {
                        Row (footer-actions) {
                            View (icon-button, on click: toggleTheme) {
                                Image (footer-icon) { sun }
                            }
                            View (icon-button, on click: openSettings) {
                                Image (footer-icon) { cog }
                            }
                        }
                        Text (footer-hint) { "Escape - закрыть" }
                        View (open-button, on click: openSelected) {
                            Text (open-label) { "Открыть" }
                        }
                    }
                }
            }
        }
    }

    window Settings (
        title: "bropicker - settings",
        width: 760,
        height: 560,
        on key: closeOnEscape
    ) {
        Column (settings-root) {
            Text (settings-title) { "Settings" }
            Row (settings-columns) {
                Column (settings-panel) {
                    Row (settings-head) {
                        Text (muted) { "Browsers" }
                        Text (settings-action, on click: redetect) { "Autodetect" }
                    }
                    Column (settings-list) {
                        @each (browsers as browser, index (browser.name)) {
                            SettingsRow (name: browser.name, detail: browser.path,
                                        on removed: removeBrowserRow) { }
                        }
                    }
                }
                Column (settings-panel) {
                    Row (settings-head) {
                        Text (muted) { "Saved domains" }
                    }
                    Column (settings-list) {
                        @each (remembered as record, index (record.domain)) {
                            SettingsRow (name: record.domain, detail: record.browser,
                                        on removed: removeRememberedRow) { }
                        }
                    }
                }
            }
        }
    }
</markup>

<style>
    theme dark {
        background: #14171d;
        surface: #1c2028;
        surface-main: #0f172a;
        surface-hover: lighten(theme.surface-main, 8%);
        surface-elevated: alpha(theme.surface-hover, 50%);
        surface-item: alpha(theme.surface-hover, 30%);
        border: #334155;
        text: #ffffff;
        muted: #94a3b8;
        control: #cbd5e1;
        hint: #475569;
        accent: #3b82f6;
        accent-to: #06b6d4;
        accent-ring: alpha(theme.accent, 50%);
        accent-soft: alpha(theme.accent, 12.5%);
        badge-text: lighten(theme.accent, 11%);
        danger: #f87171;
        icon-backplate: #334155;
        plate-warm-from: #fb923c;
        plate-warm-to: #ef4444;
        plate-rose-from: #f472b6;
        plate-rose-to: #e11d48;
        plate-cyan-from: #22d3ee;
        plate-cyan-to: #10b981;
        plate-violet-from: #a78bfa;
        plate-violet-to: #7c3aed;
    }
    theme light {
        background: #f4f6f9;
        surface: #ffffff;
        surface-main: #ffffff;
        surface-hover: lighten(theme.surface-main, 8%);
        surface-elevated: darken(theme.surface-main, 2%);
        surface-item: darken(theme.surface-main, 2%);
        border: #e2e8f0;
        text: #0f172a;
        muted: #64748b;
        control: #475569;
        hint: #475569;
        accent: #3b82f6;
        accent-to: #06b6d4;
        accent-ring: alpha(theme.accent, 50%);
        accent-soft: alpha(theme.accent, 12.5%);
        badge-text: lighten(theme.accent, 11%);
        danger: #dc2626;
        icon-backplate: #e2e8f0;
        plate-warm-from: #fb923c;
        plate-warm-to: #ef4444;
        plate-rose-from: #f472b6;
        plate-rose-to: #e11d48;
        plate-cyan-from: #22d3ee;
        plate-cyan-to: #10b981;
        plate-violet-from: #a78bfa;
        plate-violet-to: #7c3aed;
    }
    .root {
        width: 100%;
        height: 100%;
        padding: 20px;
        background: transparent;
    }
    .card {
        width: 100%;
        height: 100%;
        background: theme.surface-main;
        border: 1px theme.border;
        border-radius: 16px;
        clip: true;
    }
    .header {
        width: 100%;
        padding-left: 12px;
