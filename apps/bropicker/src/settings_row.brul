<script>
    function remove() {
        removed(name);
    }
</script>

<markup>
    component SettingsRow {
        prop name: String = "";
        prop detail: String = "";
        event removed(value: String);

        Row (row) {
            Column (details) {
                Text (name) { name }
                Text (detail-text) { detail }
            }
            Text (remove, on click: remove) { "Remove" }
        }
    }
</markup>

<style>
    .row {
        width: 100%;
        height: 52px;
        padding-left: 12px;
        padding-right: 10px;
        gap: 12px;
        align-items: center;
        background: theme.surface;
        border-radius: 10px;
    }
    .details { flex-grow: 1; gap: 2px; }
    .name { color: theme.text; font-size: 14px; font-weight: 600; }
    .detail-text { color: theme.muted; font-size: 11px; }
    .remove { color: theme.danger; font-size: 12px; padding: 6px; }
</style>
