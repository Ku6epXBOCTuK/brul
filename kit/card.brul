<markup>
    component Card {
        View (card) {
            @slot(header)
            View (card-body) {
                @slot
            }
            @slot(footer)
        }
    }
</markup>

<style>
    .card {
        width: 100%;
        background: theme.surface;
        border: 1px theme.border;
        border-radius: 14px;
        clip: true;
    }
    .card-body {
        width: 100%;
        padding: 16px;
        gap: 8px;
    }
</style>
