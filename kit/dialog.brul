<script>
    function accept() {
        closed(true);
    }

    function reject() {
        closed(false);
    }

    function dismissDialog() {
        closed(false);
    }
</script>

<use>
    import Button from "brul:button";
</use>

<markup>
    component Dialog {
        prop open: Bool = false;
        prop title: String = "";
        prop confirm: String = "Сохранить";
        prop cancel: String = "Отмена";
        event closed(result: Bool);

        Layer (dialog-layer, visible: open, modal: true, on dismiss: dismissDialog) {
            View (dialog-scrim, x: 0, y: 0, on click: dismissDialog) { }
            Column (dialog-card) {
                Text (dialog-title) { title }
                View (dialog-body) { @slot }
                Row (dialog-actions) {
                    Button (label: cancel, on clicked: reject) { }
                    Button (label: confirm, variant: "primary", on clicked: accept) { }
                }
            }
        }
    }
</markup>

<style>
    .dialog-layer {
        align-items: center;
        justify-content: center;
    }
    .dialog-scrim {
        width: 100%;
        height: 100%;
        background: alpha(#000000, 45%);
    }
    .dialog-card {
        width: 420px;
        padding: 20px;
        gap: 16px;
        background: theme.surface;
        border: 1px theme.border;
        border-radius: 14px;
    }
    .dialog-title {
        color: theme.text;
        font-size: 16px;
        font-weight: 600;
    }
    .dialog-body {
        width: 100%;
        gap: 12px;
    }
    .dialog-actions {
        width: 100%;
        justify-content: end;
        gap: 8px;
    }
</style>
