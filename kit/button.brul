<script>
    function press(): Void {
        clicked();
    }
</script>

<markup>
    component Button {
        prop label: String = "";
        prop variant: String = "secondary";
        prop disabled: Bool = false;
        event clicked();

        View (button, class: variant, focusable: true, disabled: disabled, on click: press) {
            @slot(icon)
            Text (button-label) { label }
        }
    }
</markup>

<style>
    .button {
        height: 32px;
        padding-left: 16px;
        padding-right: 16px;
        gap: 6px;
        align-items: center;
        justify-content: center;
        border: 1px transparent;
        border-radius: 10px;
        background: theme.surface;
        box-shadow-offset-x: 0px;
        box-shadow-offset-y: 0px;
        box-shadow-blur: 4px;
        box-shadow-color: transparent;
        animate background: 200ms;
    }
    .button:hover { background: theme.surface-hover; }
    .button:focus {
        border-color: theme.accent;
        box-shadow-color: theme.accent;
    }
    .button:disabled { opacity: 0.45; }
    .secondary { background: theme.surface; border-color: theme.border; }
    .secondary:hover { background: theme.surface-hover; }
    .primary { background: theme.accent; border-color: theme.accent; }
    .primary:hover { background: theme.accent-hover; }
    .ghost { background: transparent; border-color: transparent; }
    .ghost:hover { background: theme.surface; }
    .button-label {
        color: theme.text;
        font-size: 13px;
        font-weight: 600;
        vertical-align: center;
    }
</style>
