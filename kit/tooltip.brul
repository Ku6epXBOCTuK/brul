<script>
    let shown: Bool = false;

    function show(): Void {
        shown = true;
    }

    function hide(): Void {
        shown = false;
    }
</script>

<markup>
    component Tooltip {
        prop text: String = "";

        Container (tooltip, #tooltip-anchor) {
            @slot
            Layer (bubble-layer, visible: shown) {
                Container (bubble, anchor: @tooltip-anchor) {
                    Text (bubble-text) { text }
                }
            }
        }
    }
</markup>

<style>
    .tooltip {
        width: 100%;
    }
    .bubble {
        anchor-side: bottom;
        anchor-gap: 6px;
        anchor-align: center;
        anchor-flip: true;
        padding: 8px 12px;
        background: theme.surface;
        border: 1px theme.border;
        border-radius: 8px;
    }
    .bubble-text {
        color: theme.muted;
        font-size: 12px;
    }
</style>
