<script>
    let phase: Number;

    function setPhase(ev: Object): Void {
        phase = Number(ev.value);
    }
</script>

<markup>
    window Aurora (
        title: "aurora",
        width: 640,
        height: 360,
        centered: true
    ) {
        Container (grid) {
            Container (pane) { Text (caption) { "Aurora" } }
            Container (second) { Text (second-caption) { "Plain" } }
            Container (third) { }
            TextInput (phase-field, on input: setPhase) { "" }
        }
    }
</markup>

<style>
    theme dark {
        background: #0b1020;
        surface: #141b30;
        text: #e8eefc;
    }
    theme light {
        background: #eef2fb;
        surface: #ffffff;
        text: #0f172a;
    }
    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        width: 100%;
        height: 100%;
        gap: 12px;
        padding: 16px;
        background: theme.background;
    }
    .pane {
        effect: Aurora(phase, 0.25, 0.85, 0.65, 0.90, 9.0, 0.35, 0.22, 0.45);
        border-radius: 12px;
    }
    .second { background: theme.surface; border-radius: 12px; }
    .third { background: theme.surface; border-radius: 12px; }
    .phase-field {
        background: theme.surface;
        color: theme.text;
        font-size: 18px;
    }
    .caption { color: theme.text; font-size: 18px; }
    .second-caption { color: theme.text; font-size: 18px; }
</style>
