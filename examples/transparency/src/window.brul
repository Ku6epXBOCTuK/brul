<script>
    function closeOnEscape(ev: Object): Void {
        if (ev.code == "Escape") {
            exit();
        }
    }

    function toggleTheme(): Void {
        setTheme(theme() == "dark" ? "light" : "dark");
    }
</script>

<markup>
    window Transparency (
        title: "transparency repro",
        width: 400,
        height: 280,
        frameless: true,
        transparent: true,
        centered: true,
        on key: closeOnEscape
    ) {
        Column (root) {
            Column (card) {
                Text (label) { "Semi-transparent card" }
                Text (hint) { "Esc to exit" }
            }
        }
    }
</markup>

<style>
    theme dark {
        card: alpha(#0f172a, 85%);
        border: alpha(#ffffff, 20%);
        text: #ffffff;
        muted: #94a3b8;
    }
    theme light {
        card: alpha(#ffffff, 85%);
        border: alpha(#0f172a, 20%);
        text: #0f172a;
        muted: #64748b;
    }
    .root {
        width: 100%;
        height: 100%;
        padding: 32px;
        background: transparent;
    }
    .card {
        width: 100%;
        height: 100%;
        padding: 16px;
        gap: 8px;
        background: theme.card;
        border: 1px theme.border;
        border-radius: 16px;
        box-shadow: 0px 10px 16px alpha(#000000, 50%);
    }
    .label { color: theme.text; font-size: 18px; }
    .hint { color: theme.muted; font-size: 12px; }
</style>
