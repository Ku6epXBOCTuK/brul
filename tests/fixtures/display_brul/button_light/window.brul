<use>
    import Button from "brul:button";
</use>

<markup>
    window ButtonLight (
        title: "button light",
        width: 240,
        height: 120
    ) {
        Container (root) {
            Container (row) {
                Button (label: "Save", variant: "primary") { }
                Button (label: "Clear") { }
            }
        }
    }
</markup>

<style>
    theme dark {
        background: #12141c;
        surface: #1c2028;
        surface-hover: #232936;
        border: #334155;
        text: #ffffff;
        muted: #8c94a8;
        accent: #4c8dff;
        accent-hover: #6ba0ff;
    }
    theme light {
        background: #f4f6f9;
        surface: #ffffff;
        surface-hover: #eef2f7;
        border: #e2e8f0;
        text: #0f172a;
        muted: #64748b;
        accent: #2563eb;
        accent-hover: #1d4ed8;
    }
    .root {
        width: 100%;
        height: 100%;
        padding: 16px;
        background: theme.background;
    }
    .row {
        width: 100%;
        gap: 10px;
        align-items: center;
    }
</style>
