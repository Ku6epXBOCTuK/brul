<use>
    import Input from "brul:input";
    import Checkbox from "brul:checkbox";
</use>

<markup>
    window InputCheckbox (
        title: "input and checkbox",
        width: 320,
        height: 140
    ) {
        Container (root) {
            Input (field, value: "ab") { }
            Checkbox (remember, label: "Remember", checked: true) { }
            Checkbox (notify, label: "Notify") { }
        }
    }
</markup>

<style>
    theme dark {
        background: #12141c;
        surface: #1c2028;
        surface-hover: #232936;
        border: #334155;
        text: #ffffff;
        muted: #8c94a8;
        accent: #4c8dff;
        accent-hover: #6ba0ff;
    }
    theme light {
        background: #f4f6f9;
        surface: #ffffff;
        surface-hover: #eef2f7;
        border: #e2e8f0;
        text: #0f172a;
        muted: #64748b;
        accent: #2563eb;
        accent-hover: #1d4ed8;
    }
    .root {
        width: 100%;
        height: 100%;
        flex-direction: column;
        padding: 16px;
        gap: 10px;
        background: theme.background;
    }
    .field {
        width: 100%;
        height: 32px;
        padding-left: 10px;
        padding-right: 10px;
        background: theme.surface;
        border: 1px theme.border;
        border-radius: 10px;
        color: theme.text;
        font-size: 13px;
    }
</style>
