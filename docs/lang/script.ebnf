Expr        = Assignment ;
Assignment  = Ternary [ ("=" | "+=" | "-=") Assignment ] ;
Ternary     = LogicOr [ "?" Expr ":" Ternary ] ;
LogicOr     = LogicAnd { "||" LogicAnd } ;
LogicAnd    = Equality { "&&" Equality } ;
Equality    = Comparison { ("==" | "!=") Comparison } ;
Comparison  = Term { ("<" | ">" | "<=" | ">=") Term } ;
Term        = Factor { ("+" | "-") Factor } ;
Factor      = Unary { ("*" | "/" | "%") Unary } ;
Unary       = [ "!" | "-" ] Postfix ;
Postfix     = Primary { "." Ident | "(" [ ArgList ] ")" | "[" Expr "]" } ;
Primary     = Number | String | Template | "true" | "false" | "null" | "empty"
            | Ident | Array | Object | "(" Expr ")" ;
ArgList     = Expr { "," Expr } ;
Array       = "[" [ Expr { "," Expr } ] "]" ;
Object      = "{" [ Ident ":" Expr { "," Ident ":" Expr } ] "}" ;
Template    = "`" { TemplateChar | "${" Expr "}" } "`" ;

Program      = { FunctionDecl | Statement } ;
FunctionDecl = "function" Ident "(" [ ParamList ] ")" ":" Type Block ;
ParamList    = Param { "," Param } ;
Param        = Ident ":" Type ;
Statement    = LetStmt | IfStmt | ReturnStmt | ExprStmt | Block ;
LetStmt      = "let" Ident ":" Type [ "=" Expr ] ";"
             | "const" Ident ":" Type "=" Expr ";" ;
IfStmt       = "if" "(" Expr ")" Block [ "else" ( IfStmt | Block ) ] ;
ReturnStmt   = "return" [ Expr ] ";" ;
ExprStmt     = Expr ";" ;
Block        = "{" { Statement } "}" ;
Type         = "Number" | "String" | "Bool" | "Null" | "Image"
             | "Array" "<" Type ">" | "Object" | "Void" ;

Ident        = letter { letter | digit | "_" } ;
Number       = digit { digit } [ "." digit { digit } ] ;
String       = '"' { ? any character except '"' and newline ? } '"' ;
TemplateChar = ? any character except "`" and "$" ? ;
letter       = ? ASCII letter ? ;
digit        = ? ASCII digit ? ;
