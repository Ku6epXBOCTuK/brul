File          = [ ComponentDecl | WindowDecl ] ;
ComponentDecl = "component" Ident "{" { Member } "}" ;
WindowDecl    = "window" Ident "(" ArgList ")" "{" { Member } "}" ;

Member        = PropDecl | EventDecl | Element | Slot | IfBlock | EachBlock ;
PropDecl      = "prop" Ident ":" PropType [ "=" Script.Expr ] ";" ;
PropType      = Script.Type ;
EventDecl     = "event" Ident [ "(" [ EventParamList ] ")" ] ";" ;
EventParamList= EventParam { "," EventParam } ;
EventParam    = Ident ":" PropType ;

Element       = Ident [ "(" ArgList ")" ] Block ;
ArgList       = Arg { "," Arg } ;
Arg           = Ident                       (* класс стилей *)
              | AnchorName                  (* статическое имя якоря *)
              | Ident ":" Script.Expr       (* параметр/привязка *)
              | AnchorRef                   (* ссылка на имя якоря *)
              | HandlerRef                  (* обработчик *)
              | AttachRef ;                 (* Rust-поведение элемента *)
AttachRef     = "use" ":" Ident [ "(" AttachParams ")" ] ;
AttachParams  = Ident ":" Script.Expr { "," Ident ":" Script.Expr } ;
AnchorName    = "#" Ident ;                 (* объявление имени, не класс *)
AnchorRef     = "anchor" ":" "@" Ident ;    (* геометрия якоря задаётся стилями *)
HandlerRef    = "on" EventName ":" Ident ;  (* справа имя функции, не выражение *)
Block         = "{" { BlockItem } "}" ;
BlockItem     = Element | IfBlock | EachBlock | Slot ;
Slot          = "@slot" [ "(" Ident ")" ] [ Block ] ;
IfBlock       = "@if" "(" Script.Expr ")" Block { "@else" "if" "(" Script.Expr ")" Block } [ "@else" Block ] ;
EachBlock     = "@each" "(" Script.Expr "as" Ident [ "," Ident ] [ "(" Script.Expr ")" ] ")" Block [ "@else" Block ] ;
EventName     = "click" | "key" | "drag" | Ident ;

Ident         = letter { letter | digit | "-" | "_" } ;
letter        = ? ASCII letter ? ;
digit         = ? ASCII digit ? ;
