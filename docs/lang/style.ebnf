Stylesheet  = { ThemeBlock | ClassRule } ;
ThemeBlock  = "theme" Ident "{" { ThemeProp } "}" ;
ThemeProp   = Ident ":" Value ";" ;
ClassRule   = "." Ident [ ":" State ] "{" { Prop | Animation } "}" ;
State       = "hover" | "pressed" | "checked" | "selected" | "disabled" ;
Prop        = Ident ":" Value { Value } ";" ;
Animation   = "animate" Ident ":" Duration ";" ;
Duration    = Number "ms" ;
Value       = Number | Number "px" | Number "%" | Color | String
            | ThemeRef | Gradient | Bool | Keyword ;
Keyword     = Ident ;
Bool        = "true" | "false" ;
Gradient    = "linear-gradient" "(" Number [ "deg" ] "," Color "," Color ")" ;
ThemeRef    = "theme" "." Ident ;

Ident       = letter { letter | digit | "-" | "_" } ;
Number      = digit { digit } [ "." digit { digit } ] ;
String      = '"' { ? any character except '"' and newline ? } '"' ;
Color       = "#" hexDigit { hexDigit } | "transparent" | "white" ;
letter      = ? ASCII letter ? ;
digit       = ? ASCII digit ? ;
hexDigit    = ? ASCII hex digit ? ;
