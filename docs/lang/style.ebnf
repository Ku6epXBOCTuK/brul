Stylesheet  = { ThemeBlock | OverrideBlock | ClassRule } ;
ThemeBlock  = "theme" Ident "{" { ThemeProp } "}" ;
ThemeProp   = Ident ":" ThemeValue ";" ;
OverrideBlock = "override" Ident "{" { ClassRule } "}" ;
ClassRule   = "." Ident [ ":" State ] "{" { Prop | Animation } "}" ;
State       = "hover" | "pressed" | "checked" | "selected" | "disabled" ;
Prop        = Ident ":" Value { Value } ";" ;
Animation   = "animate" Ident ":" Duration ";" ;
Duration    = Number "ms" ;
Value       = Number | Number "px" | Number "%" | Color | String
            | ThemeRef | ColorExpr | Gradient | Bool | Keyword
            | TrackList | GridLine ;
TrackList   = TrackSize { TrackSize } ;
TrackSize   = Number "fr" | Number "px" | Number "%"
            | "minmax" "(" TrackSize "," TrackSize ")" ;
GridLine    = LinePlacement [ "/" LinePlacement ] ;
LinePlacement = "auto" | "span" Number | [ "-" ] Number ;
Keyword     = Ident ;
Bool        = "true" | "false" ;
Gradient    = "linear-gradient" "(" Number [ "deg" ] "," ColorValue "," ColorValue ")" ;
ThemeRef    = "theme" "." Ident ;
ColorValue  = Color | ThemeRef | ColorExpr ;
ColorExpr   = ( "alpha" | "lighten" | "darken" ) "(" ColorValue "," Percent ")"
            | "mix" "(" ColorValue "," ColorValue "," Percent ")" ;
ThemeValue  = Color | ColorExpr | Number "px" ;
Percent     = Number "%" ;

Ident       = letter { letter | digit | "-" | "_" } ;
Number      = digit { digit } [ "." digit { digit } ] ;
String      = '"' { ? any character except '"' and newline ? } '"' ;
Color       = "#" hexDigit { hexDigit } | "transparent" | "white" ;
letter      = ? ASCII letter ? ;
digit       = ? ASCII digit ? ;
hexDigit    = ? ASCII hex digit ? ;
